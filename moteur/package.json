{
  "name": "urbasim-moteur",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "district": "rolldown scripts/fetch-district.ts -f esm -p node -o .build/fetch-district.mjs && node .build/fetch-district.mjs",
    "commune": "rolldown scripts/fetch-commune.ts -f esm -p node -o .build/fetch-commune.mjs && node .build/fetch-commune.mjs",
    "simulate": "rolldown scripts/simulate.ts -f esm -p node -o .build/simulate.mjs && node .build/simulate.mjs",
    "market": "rolldown scripts/market-stats.ts -f esm -p node -o .build/market-stats.mjs && node .build/market-stats.mjs",
    "margins": "rolldown scripts/margins.ts -f esm -p node -o .build/margins.mjs && node .build/margins.mjs",
    "bench-open": "rolldown scripts/bench-open.ts -f esm -p node -o .build/bench-open.mjs && node .build/bench-open.mjs",
    "outline": "rolldown scripts/add-outline.ts -f esm -p node -o .build/add-outline.mjs && node .build/add-outline.mjs",
    "reprice": "rolldown scripts/reprice-district.ts -f esm -p node -o .build/reprice-district.mjs && node .build/reprice-district.mjs"
  },
  "dependencies": {
    "polygon-clipping": "^0.15.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
